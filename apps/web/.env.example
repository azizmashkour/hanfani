# Web app port (default: 3004 to avoid conflicts with 3000–3003)
PORT=3004

# API base URL for the status page and API calls
# Use 8001 if port 8000 is already in use
NEXT_PUBLIC_API_URL=http://localhost:8001

# CHAI Public Model Cards API (server-only; used by /api/chai/public-model-cards)
# Base URL of the CHAI registry (see public/chai-public-api/CHAI_API_DOC.md)
CHAI_PUBLIC_API_BASE_URL=http://localhost:8000
# Registry auth — two separate env vars (no JSON array):
CHAI_REGISTRY_PUBLIC_KEY=your-public-key
CHAI_REGISTRY_SECRET_KEY=your-secret-key
# Optional: trusted org slug on the registry (sent as Chai-Registry-Org-Slug to upstream)
CHAI_REGISTRY_ORG_SLUG=coalition-for-health-ai
